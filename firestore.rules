rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'r8lFDyFoDTUffnwN6waBm0cMlHl1';
    }
    match /products/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string && request.resource.data.photo.size() <= 550000));
      allow delete: if isAdmin();
    }
    match /settings/store {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /orders/{id} {
      // Retain existing guest / LINE-worker checkout. Only the configured admin reads orders.
      allow create: if request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerPhone is string
        && request.resource.data.customerPhone.size() > 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }
  }
}
